---
// ShineField — the dust field behind Day One / Momentum's headings.
//
// This used to be an SVG <pattern> of ~760 <rect> squares, tiled across
// the section, with two effects layered on top: a fade-out mask past
// bandEnd, and two slowly sweeping "hide" bands driven by GSAP
// animating CSS custom properties feeding calc()-based mask-image
// gradients. Both pieces turned out to be real, independent sources of
// sustained memory growth on iPad — confirmed live: the tab survived
// ~25s sitting on Day One (up from crashing almost immediately) after
// collapsing the sweep masks from three nested elements to one, but
// still eventually reloaded/crashed. Two separate WebKit costs were
// compounding:
//   1. mask-image whose calc()-driven VALUE changes every frame (GSAP
//      rewriting --band/--band-y) forces a full gradient reparse +
//      re-rasterization every tick, and WebKit doesn't reliably
//      reclaim those regenerated backing stores fast enough under
//      sustained animation.
//   2. ~30 sparkle squares with individual `animation: ... infinite`
//      lived *inside* the SVG <pattern> definition. A pattern's tile is
//      normally rasterized once and cached, then cheaply repeated —
//      but animating anything inside it invalidates that cache, and
//      with ~30 independently-timed infinite loops there's essentially
//      never a moment the tile is fully settled, forcing continuous
//      re-rasterization and re-tiling of the *entire* fill area for as
//      long as the section stays in view. This one was completely
//      unaffected by the mask-image fix.
//
// Canvas sidesteps both at once: no mask-image at all (the height-fade
// and both sweep bands are just per-square alpha math at draw time),
// and no SVG pattern to invalidate (every square is a plain fillRect
// into one bitmap the browser never has to re-tile). It's also already
// proven out on iPad/iPhone in this exact codebase — see GridField,
// the WindowA/KeepUp canvas decoration this mirrors structurally. See
// src/scripts/shineField.ts for the actual drawing/animation.
interface Props {
  class?: string;
  /** Tile width in px — the square pattern repeats at this interval. */
  tile?: number;
  /** Tile height in px — independent of width; squares grow larger
      toward the bottom of each tile (see shineField.ts), and the field
      is faded out well before most tiles ever repeat vertically. */
  tileHeight?: number;
  /** Average spacing between squares within the tile, in px. */
  cell?: number;
  /** % of the container's own height where the visible field fades out
      — solid from the very top down to this point (past the section's
      own heading), transparent below it (short of whatever content
      comes next). */
  bandEnd?: number;
  /** % of container height the fade-out itself spans, ending exactly
      at bandEnd — 8 (the default) reads as a fairly quick fade right
      near the cutoff; a larger value spreads it into a long, gradual
      dim that's already faint well above bandEnd. */
  fadeWidth?: number;
  /** bandEnd/fadeWidth to use instead, below `mobileBreakpoint`px —
      omit to use the same values at every width. */
  mobileBandEnd?: number;
  mobileFadeWidth?: number;
  mobileBreakpoint?: number;
  /** The exact solid colour immediately behind this instance's own
      section — the sweep bands dim squares toward this colour rather
      than truly erasing them, so it needs to be a real match, not a
      guess. */
  bg?: string;
}
const {
  class: className,
  tile = 500,
  tileHeight = 260,
  cell = 13,
  bandEnd = 30,
  fadeWidth = 8,
  mobileBandEnd,
  mobileFadeWidth,
  mobileBreakpoint = 799,
  bg = "#FFFAF5",
} = Astro.props;

const config = JSON.stringify({
  tile, tileHeight, cell, bandEnd, fadeWidth, bg,
  mobileBandEnd: mobileBandEnd ?? bandEnd,
  mobileFadeWidth: mobileFadeWidth ?? fadeWidth,
  mobileBreakpoint,
});
---

<canvas class:list={["shine-wrap", className]} aria-hidden="true" data-config={config}></canvas>

<script>
  import { setupShineField } from "../scripts/shineField";
  setupShineField();
</script>

<style>
  .shine-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>
