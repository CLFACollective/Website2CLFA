---
import ShineField from "./ShineField.astro";
---

<section class="sec sec--slate pinday" id="partnering">
  <div class="pinday__stage">
    <!-- Below 799px the rail is replaced by the vertical timeline inside
         .cols3 itself, so the heading and the cards sit right on top of
         each other there — no room to extend past the heading without
         running into the cards, unlike desktop's ~60px rail gap. Both
         mobile values are measured against "already off."'s own bottom
         edge (not the rail/cards) — no squares should sit at or below
         that line, and the fade should already read as faint well
         above it, not cut off sharply right at it. -->
    <ShineField
      class="shine-dayone"
      bandEnd={48}
      fadeWidth={30}
      mobileBandEnd={37}
      mobileFadeWidth={14}
      bg="#FFFAF5"
    />
    <div class="shimmer" aria-hidden="true"></div>
    <div class="sec__inner">
      <h2 class="sec__head reveal">
        <span class="bd">Day one.</span><br />
        And the training wheels<br />
        are <span class="bd hot">already off.</span>
      </h2>

      <div class="rail" id="rail">
        <span class="rail__fill"></span>
        <i class="rail__stop"></i>
        <i class="rail__stop"></i>
        <i class="rail__stop"></i>
        <i class="rail__ball"></i>
      </div>

      <div class="cols3" id="dayone">
        <div class="col">
          <h3>Fast starts</h3>
          <p>Quality deliverables in days, not weeks. We&rsquo;re moving before the ink on the SOW dries.</p>
        </div>
        <div class="col">
          <h3>No hand-holding<br />required.</h3>
          <p>Our team has seen it all. We orient ourselves.</p>
        </div>
        <div class="col">
          <h3>Strategy baked<br />in from day one</h3>
          <p>We don&rsquo;t execute first and think later.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupDayOne } from "../scripts/dayOne";
  setupDayOne();
</script>
