---
// BlingField — decorative shimmer-dust canvas. See src/scripts/blingField.ts.
interface Props {
  class?: string;
  parallax?: number;
  /** Wildness of the twinkle — see BlingFieldOptions.chaos. */
  chaos?: number;
  shape?: "circle" | "square";
  /** Fraction of dots painted pink instead of ink — see BlingFieldOptions.accentChance. */
  accentChance?: number;
}
const { class: className, parallax, chaos, shape, accentChance } = Astro.props;
---

<canvas
  class:list={["bling-field", className]}
  aria-hidden="true"
  data-parallax={parallax}
  data-chaos={chaos}
  data-shape={shape}
  data-accent-chance={accentChance}
></canvas>

<style>
  .bling-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  import { mountBlingField } from "../scripts/blingField";

  document.querySelectorAll<HTMLCanvasElement>(".bling-field:not([data-mounted])").forEach((canvas) => {
    canvas.dataset.mounted = "true";
    const parallax = canvas.dataset.parallax ? Number(canvas.dataset.parallax) : undefined;
    const chaos = canvas.dataset.chaos ? Number(canvas.dataset.chaos) : undefined;
    const shape = canvas.dataset.shape as "circle" | "square" | undefined;
    const accentChance = canvas.dataset.accentChance ? Number(canvas.dataset.accentChance) : undefined;
    mountBlingField(canvas, {
      ...(parallax !== undefined ? { parallax } : {}),
      ...(chaos !== undefined ? { chaos } : {}),
      ...(shape !== undefined ? { shape } : {}),
      ...(accentChance !== undefined ? { accentChance } : {}),
    });
  });
</script>
