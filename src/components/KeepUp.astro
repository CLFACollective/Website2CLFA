---
import GridField from "./GridField.astro";
---

<section class="sec sec--forest keepup" data-keep style="background:#344338;color:#FFFAF5">
  <GridField />
  <div class="sec__inner">
    <h2 class="keepup__big reveal">
      And after day one?<br class="mobile-br" /> <span class="bd" style="font-weight:800;letter-spacing:0;color:var(--flare)">We don&rsquo;t let up.</span>
    </h2>
    <p class="keepup__body reveal" style="font-size:48px;line-height:55px;letter-spacing:-1.568px;opacity:1">
      We&rsquo;re not a sprint team.<br class="mobile-br" /> (Well. We&rsquo;re not <strong style="font-weight:600;font-style:italic">just</strong> a sprint team.)<br class="mobile-br" /> We&rsquo;re built to roll out cohesive systems<br class="mobile-br" /> of work without losing speed.
    </p>
  </div>
</section>
