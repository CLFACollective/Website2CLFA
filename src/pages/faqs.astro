---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageOpener from "../components/PageOpener.astro";
import QAAccordion from "../components/QAAccordion.astro";
---

<Layout
  title="FAQs — CLFA Collective"
  description="Asked and answered — everything you want to know about working with CLFA Collective."
  hideKickoff
>
  <Nav />
  <main id="main" tabindex="-1">
    <PageOpener id="faqs" compact>
      <h1 class="qa__head">
        <span class="opener__line">Asked</span>
        <strong class="opener__line qa__head--alt">and answered.</strong>
      </h1>
    </PageOpener>
    <QAAccordion />
  </main>
  <Footer />
  <script>
    import "../scripts/main";
  </script>
</Layout>

<style>
  .qa__head { margin: 0; display: grid; justify-items: start; }
  .qa__head .opener__line {
    font-weight: 300; font-size: clamp(42px, 6.6vw, 126px); line-height: 1.05; letter-spacing: -.045em;
  }
  /* qualified past .qa__head .opener__line on purpose — see the
     matching comment in what-we-do.astro. */
  .qa__head .opener__line.qa__head--alt { font-weight: 800; color: var(--orange); }
</style>
