---
// Hero — the opening movie, then a normal page.
//
// A rose prelude circle carrying the CLFA mark contracts to nothing, an
// outlined iris opens back out of that same point, three beats of copy
// play through an iris/swipe/iris cycle (the third holds open while its
// middle word cycles "smarter" -> "faster" -> "better"), then the whole
// frame blooms
// into rose and the "We are the solve for brands in motion" headline
// fades up. That's the whole movie — one GSAP timeline that just plays
// once, at a fixed pace (see src/scripts/hero.ts), scroll locked for its
// ~10s runtime so it's actually watched rather than however fast someone
// happens to scroll past it. Once it completes, the pink bloom becomes
// this section's resting frame, the "Scroll" cue arrives, and scrolling
// unlocks — .hcb__after below (the old cream-circle-rise stage) is
// ordinary scroll content from there, ridden in via the site's normal
// .reveal fade-up, not part of the movie.
import ClfaMark from "./ClfaMark.astro";

const CREAM = "#FEFCF4";
const CHARCOAL = "#252525";
const COPPER = "#BE7837";
const AZURE = "#527078";
const ROSE = "#F06996";
const OLIVE = "#A0A073";
---

<section class="hcb" id="hero">
  <div class="hcb__stage" data-motion="iris" data-ring="on">
    <div class="hcb__iris">
      <p class="hcb__beat">
        <span class="hcb__lead">Where healthcare meets tech,</span>
        <span class="hcb__emph">the ground</span>
        <span class="hcb__emph">keeps shifting</span>
      </p>
      <p class="hcb__beat">
        <span class="hcb__lead">When your organization is</span>
        <span class="hcb__emph">changing rapidly</span>
      </p>
      <p class="hcb__beat" data-swap>
        <span class="hcb__lead">We are the</span>
        <span class="hcb__swap">
          <span class="hcb__emph hcb__emph--swap" data-word="a">smarter</span>
          <span class="hcb__emph hcb__emph--swap" data-word="b" style={`color:${AZURE}`}>faster</span>
          <span class="hcb__emph hcb__emph--swap" data-word="c" style={`color:${OLIVE}`}>better</span>
        </span>
        <span class="hcb__emph">solve</span>
      </p>
    </div>

    <span class="hcb__dot" aria-hidden="true">
      <ClfaMark class="hcb__dotmark" />
    </span>
    <span class="hcb__ring" aria-hidden="true"></span>
    <span class="hcb__flood" aria-hidden="true"></span>

    <div class="hcb__lockup">
      <h1 class="hcb__head">
        <span class="hcb__lead">We are the</span>
        <span class="hcb__solve" id="hcbSolve">solve</span>
        <span class="hcb__tail">
          <i class="hcb__arrow" aria-hidden="true"></i>
          <em>for brands in motion</em>
        </span>
      </h1>
    </div>

    <span class="hcb__cue" aria-hidden="true">Scroll<i></i></span>

    <button type="button" class="hcb__replay" aria-label="Replay intro" data-cursor="ring">
      <span>Replay</span>
      <svg class="hcb__replay-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 12a8 8 0 1 1-2.34-5.66" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path d="M20 4v6h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</section>

<section class="hcb__after">
  <p class="hcb__closing reveal">
    We&rsquo;re an adaptable healthcare B2B agency network of highly
    experienced thinkers who&nbsp;connect <strong>strategy, creative, and execution</strong> to
    tackle it head-on.
  </p>
</section>

<script>
  import { setupHero } from "../scripts/hero";
  setupHero();
</script>

<style define:vars={{ CREAM, CHARCOAL, COPPER, AZURE, ROSE }}>
  .hcb { position: relative; }
  .hcb__stage {
    position: relative; height: 100svh; overflow: hidden;
    background: var(--CREAM); color: var(--CHARCOAL);
    display: grid; place-items: center;
    --dot-k: 0; --dot-op: 0; --mark-op: 0; --ring: 0;
    --wipe-l: 0; --wipe-r: 1;
    --flood: 0; --head: 0;
    --hc-lead: clamp(20px, calc(9.25px + 2.85vw), 64px);
  }

  .hcb__iris {
    position: absolute; inset: 0; display: grid; place-items: center;
    padding: 0 clamp(24px, 6vw, 120px);
    will-change: clip-path;
  }
  .hcb__stage[data-motion="iris"] .hcb__iris { clip-path: circle(calc(var(--ring) * 49vmin) at 50% 50%); }
  .hcb__stage[data-motion="swipe"] .hcb__iris { clip-path: inset(0 calc(var(--wipe-r) * 100%) 0 calc(var(--wipe-l) * 100%)); }
  .hcb__stage[data-motion="bloom"] .hcb__iris { clip-path: circle(0 at 50% 50%); }

  .hcb__beat {
    /* display stays grid at all times now (not toggled with display:none
       per active beat) — opacity is a continuous per-frame value from
       hero.ts's scroll-scrubbed cross-fade, so all three sit stacked in
       this shared grid cell (grid-area: 1/1) the whole time, and only
       the currently-relevant one is ever above ~0 opacity (or two,
       briefly, mid cross-fade — the whole point). */
    grid-area: 1 / 1; margin: 0; display: grid; justify-items: center; text-align: center; gap: .06em;
    opacity: 0;
  }
  .hcb__lead {
    font-weight: 300; letter-spacing: -.02em; line-height: 1.1;
    font-size: var(--hc-lead);
  }
  .hcb__emph {
    font-weight: 800; letter-spacing: -.035em; line-height: 1.0;
    font-size: clamp(34px, 5.4vw, 100px);
    color: var(--COPPER);
    max-width: 14ch;
  }
  .hcb__beat[data-swap] .hcb__emph { font-size: clamp(44px, 7vw, 134px); }
  .hcb__swap { position: relative; display: block; }
  /* "a" (word 1) sits in normal flow and sizes/positions the box; "b"
     and "c" stack absolutely on top of it, at the ready to crossfade
     in — see hero.ts's data-swap-step (0/1/2), which drives which one
     is actually opaque. */
  .hcb__emph--swap { transition: opacity .32s var(--ease); opacity: 1; }
  .hcb__emph--swap[data-word="b"], .hcb__emph--swap[data-word="c"] { position: absolute; inset: 0; opacity: 0; }
  .hcb__beat[data-swap-step="1"] .hcb__emph--swap[data-word="a"] { opacity: 0; }
  .hcb__beat[data-swap-step="1"] .hcb__emph--swap[data-word="b"] { opacity: 1; }
  .hcb__beat[data-swap-step="2"] .hcb__emph--swap[data-word="a"] { opacity: 0; }
  .hcb__beat[data-swap-step="2"] .hcb__emph--swap[data-word="c"] { opacity: 1; }

  .hcb__dot {
    position: absolute; left: 50%; top: 50%;
    width: calc((1 - var(--dot-k)) * 400px); height: calc((1 - var(--dot-k)) * 400px);
    margin: calc((1 - var(--dot-k)) * -200px) 0 0 calc((1 - var(--dot-k)) * -200px);
    border-radius: 50%; background: var(--ROSE);
    opacity: var(--dot-op); pointer-events: none; z-index: 2;
    display: grid; place-items: center; overflow: hidden;
  }
  /* :global — <ClfaMark> is a separate component, so its rendered <svg>
     never receives this file's scoping attribute; an unscoped selector
     is the only way a parent's style can reach into a child's markup. */
  :global(.hcb__dotmark) {
    width: 54%; height: auto; display: block;
    color: var(--CHARCOAL); --clfa-dot: var(--CREAM);
    opacity: var(--mark-op);
  }

  .hcb__ring {
    position: absolute; left: 50%; top: 50%;
    width: calc(var(--ring) * 98vmin); height: calc(var(--ring) * 98vmin);
    margin: calc(var(--ring) * -49vmin) 0 0 calc(var(--ring) * -49vmin);
    border: 1px solid var(--ROSE); border-radius: 50%;
    opacity: .55; pointer-events: none;
  }
  .hcb__stage[data-ring="off"] .hcb__ring { opacity: 0; }

  .hcb__flood {
    position: absolute; left: 50%; top: 50%;
    /* a circle centred on the viewport needs diameter >= the viewport's
       diagonal to cover every corner, not just >= 100vmax — worst case
       is a perfect square (diagonal ~= 141.4vmax), so 148vmax is the
       verified-safe floor with a small margin; below ~141vmax the
       corners visibly leak background on square-ish viewports (checked
       empirically at 900x900, not just by the math). */
    width: 148vmax; height: 148vmax; margin: -74vmax 0 0 -74vmax;
    border-radius: 50%; background: var(--ROSE);
    transform: scale(var(--flood));
    will-change: transform;
  }

  .hcb__lockup {
    position: relative; z-index: 3;
    display: inline-grid; justify-items: stretch;
    padding: 0 clamp(24px, 5vw, 78px);
  }
  .hcb__head {
    margin: 0; text-align: left;
    color: var(--CHARCOAL); opacity: var(--head);
    transform: translateY(calc((1 - var(--head)) * 22px));
    display: grid; justify-items: start;
  }
  .hcb__head .hcb__lead {
    margin-left: 7.4%;
    margin-bottom: -4.4vw;
    position: relative; z-index: 2;
  }
  .hcb__solve {
    /* SemiBold per Figma (node 3318:1173) — thinner than the 800 this
       used to carry. */
    font-weight: 600; letter-spacing: -.035em; line-height: .86;
    font-size: min(clamp(120px, calc(71px + 15.04vw), 360px), var(--solve-fit, 9999px));
    color: var(--CREAM);
  }
  .hcb__tail {
    display: flex; align-items: center; width: 100%;
    gap: clamp(10px, 1.6vw, 30px);
    margin-top: -.6vw;
  }
  .hcb__arrow {
    flex: 1 1 auto; min-width: 40px; height: 1.5px;
    background: var(--CHARCOAL); color: var(--CHARCOAL);
    position: relative;
  }
  .hcb__arrow::after {
    content: ""; position: absolute; right: 0; top: 50%;
    width: clamp(8px, .85vw, 17px); height: clamp(8px, .85vw, 17px);
    border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  .hcb__tail em {
    flex: 0 0 auto;
    font-family: var(--hc-serif, "Lora", Georgia, serif);
    font-style: italic; font-weight: 500; letter-spacing: -.01em;
    font-size: clamp(22px, 2.9vw, 54px);
    color: var(--CHARCOAL);
  }

  /* The old cream-circle-rise stage — a big circle physically climbing
     up to cover the pink — needed the scroll-scrubbed pin to work at
     all (its position was a direct function of scroll progress). Now
     that this is ordinary post-movie scroll content, it's just a plain
     section with a cream background; the colour transition (pink ->
     cream) still reads the same on scroll, it just isn't a bespoke
     shape doing it. */
  .hcb__after {
    background: var(--CREAM); color: var(--CHARCOAL);
    display: grid; place-items: center;
    padding: clamp(72px, 10vw, 170px) var(--gut);
  }
  .hcb__closing {
    margin: 0;
    max-width: min(26ch, 90vw); text-align: center;
    font-weight: 300; letter-spacing: -.042em; line-height: 1.16;
    font-size: clamp(22px, 4.2vw, 80px);
  }
  .hcb__closing strong { display: block; font-weight: 700; color: var(--COPPER); }

  .hcb__cue {
    position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%);
    font-size: 10px; letter-spacing: .3em; text-transform: uppercase;
    /* CREAM, not ROSE — this only ever shows once the frame has fully
       flooded pink (see the opacity comment below), so a rose cue on a
       rose background was invisible the whole time it was live. */
    color: var(--CREAM);
    /* used to be the opposite (calc(1 - var(--flood)), visible during
       the dot/beats stretch, gone by the time the frame floods pink) —
       now it only arrives once the pink bleed is reached: --flood eases
       to 1 as the bloom completes and then holds there for the rest of
       the timeline (rise + closing copy), so tracking it directly both
       brings the cue in exactly as the bleed lands and keeps it visible
       for the remainder of the section. */
    opacity: var(--flood);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .hcb__cue i {
    width: 1px; height: 32px; background: var(--CREAM); display: block;
    transform-origin: top;
    /* the grow/shrink pulse itself is a GSAP timeline (see hero.ts) —
       matches the pause-when-scrolled-away treatment the rest of the
       page's infinite animations already get (ShineField, marquee,
       shimmer, Day One's halo), which a CSS `animation: ... infinite`
       here didn't have. */
  }

  .hcb__replay {
    position: absolute; right: var(--gut); bottom: 26px;
    display: flex; align-items: center; gap: 8px;
    font: inherit; font-size: 10px; letter-spacing: .3em; text-transform: uppercase;
    color: var(--CREAM); background: none; border: 0; padding: 4px; margin: 0; cursor: pointer;
    opacity: var(--flood);
    /* same arrival as .hcb__cue (only relevant once the frame's fully
       bloomed) but pointer-events AND visibility stay off until the
       movie's actually done — pointer-events alone would still leave a
       fully invisible button reachable by Tab mid-movie, a trap for
       keyboard/AT users. hero.ts flips data-hero-done the instant the
       movie's onComplete fires, by which point --flood (and this
       opacity) is already at 1, so there's nothing to visibly snap. */
    pointer-events: none;
    visibility: hidden;
  }
  #hero[data-hero-done="true"] .hcb__replay { pointer-events: auto; visibility: visible; }
  .hcb__replay-icon { width: 16px; height: 16px; flex: 0 0 auto; }

  @media (max-width: 599px) {
    .hcb__replay span { display: none; }
  }

  @media (max-width: 799px) {
    .hcb__lockup { padding: 0 32px; }
    .hcb__solve { font-size: var(--solve-fit, 34vw); line-height: .76; }
    .hcb__closing { max-width: min(20ch, 86vw); }
  }

  /* No prefers-reduced-motion overrides needed for most of the above:
     hero.ts's reduced-motion branch sets the same custom properties
     (--flood: 1, --head: 1, etc.) the completed movie ends at, straight
     away — the existing property-driven rules already render the
     correct resting frame from those values alone, animated or not.
     .hcb__closing below gets its reduced-motion handling for free too,
     from the sitewide .reveal rule in global.css.
     .hcb__replay is the one exception: that branch returns before ever
     wiring a click handler (there's no timeline to restart), so without
     this it would otherwise render as a live-looking, focusable button
     that silently does nothing when activated. */
  @media (prefers-reduced-motion: reduce) {
    .hcb__replay { display: none; }
  }
</style>
