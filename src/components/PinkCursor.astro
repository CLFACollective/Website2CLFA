---
// PinkCursor — replaces the system cursor on fine-pointer devices (hidden
// globally in global.css). The dot itself is positioned by GSAP quickTo
// in src/scripts/cursor.ts, which also flips it to white whenever it sits
// over an element marked data-cursor="invert" (a pink ground would
// otherwise swallow it).
---

<div id="pink-cursor" aria-hidden="true"></div>

<style>
  #pink-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 99999;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    margin-top: -12px;
    border-radius: 50%;
    background: var(--rose, #f06996);
    pointer-events: none;
    will-change: transform;
    transform: translate(-200px, -200px);
    /* ring colour tracks the dot: pink dot → pink ring, white (inverted)
       dot → cream ring — cursor.ts sets --ring alongside the background. */
    --ring: rgba(240, 105, 150, .55);
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow .18s ease-out;
  }
  /* a visible ring grown around the dot over any link or button (and
     anything marked data-cursor="ring"), since this custom cursor
     otherwise gives no pointer-style hover feedback — see cursor.ts. */
  #pink-cursor.pink-cursor--ring {
    box-shadow: 0 0 0 7px var(--ring);
  }
  @media (pointer: fine) {
    #pink-cursor { display: block; }
  }
  @media not (pointer: fine) {
    #pink-cursor { display: none; }
  }
</style>

<script>
  import { mountPinkCursor } from "../scripts/cursor";
  mountPinkCursor();
</script>
