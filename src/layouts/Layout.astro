---
import PinkCursor from "../components/PinkCursor.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** The sticky "Is it go time?" pill only ever appears on the home
   * page, matching the Figma source — the 4 sub-pages pass this. */
  hideKickoff?: boolean;
}
const {
  title,
  description = "CLFA Collective — an adaptable healthcare B2B agency network of highly experienced thinkers who connect strategy, creative, and execution.",
  hideKickoff = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={[hideKickoff && "hide-kickoff"]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <PinkCursor />
    <slot />
  </body>
</html>
