---
// WhyCollective — the "Why a collective?" pale-cream section closing
// About, with the pink circle/arch that rides in as the section
// arrives (a continuous scroll-driven value the whole time the
// section is in view, not a one-time reveal — see
// src/scripts/whyCollective.ts), and the outlined "READY TO MOVE"
// marquee at the foot, reusing the existing marquee.ts script (same
// doubled-track technique as LogoScroller.astro).
---

<div class="abt__why" data-page-why>
  <div class="abt__why-inner">
    <div class="abt__why-a">
      <h2>Why a collective?</h2>
      <p>
        Cathy &amp; Michelle knew their clients demanded something agencies
        weren&rsquo;t serving: adaptable teams right-sized for every job, every
        challenge, every single time.
      </p>
    </div>

    <div class="abt__why-b">
      <div class="abt__why-copy">
        <p>
          You get the team you actually need&thinsp;—&thinsp;
          <em>calibrated, senior, and ready to move</em>&thinsp;—&thinsp;without
          paying for the parts you don&rsquo;t.
        </p>
      </div>
    </div>
  </div>

  <p class="abt__marquee" aria-hidden="true">
    <span class="abt__marquee-track" data-seconds="22">
      {[0, 1].map((set) => (
        <span class="abt__marquee-set" aria-hidden={set === 1}>
          READY TO MOVE&nbsp;&middot;&nbsp;READY TO MOVE&nbsp;&middot;&nbsp;READY TO MOVE&nbsp;&middot;&nbsp;
        </span>
      ))}
    </span>
  </p>
</div>

<style>
  .abt__why {
    --in: 0;
    position: relative; overflow: hidden;
    background: var(--cream);
    padding: clamp(30px, 5vw, 68px) clamp(24px, 5vw, 123px) clamp(70px, 9vw, 190px);
  }
  .abt__why-inner {
    position: relative; z-index: 1;
    max-width: 1560px; margin: 0 auto;
    min-height: clamp(390px, 38vw, 600px);
    display: grid; align-items: center;
  }
  .abt__why-a { align-self: center; max-width: min(44%, 560px); }

  /* the circle is far larger than the copy it carries — its left edge
     cuts an arc through the middle of the frame and the rest bleeds
     off the top/right/bottom, as in the comp */
  .abt__why-b {
    position: absolute; top: 50%; left: 45%;
    width: min(136vh, 1240px); aspect-ratio: 1;
    transform: translateY(-50%) translateX(calc((1 - var(--in)) * 70vw));
    will-change: transform;
    border-radius: 50%; background: var(--rose);
    display: grid; align-content: center;
    padding-left: clamp(28px, 7%, 110px);
    box-sizing: border-box;
  }
  .abt__why-copy { max-width: clamp(310px, 33vw, 540px); }
  .abt__why .abt__why-copy p { font-size: 22px; letter-spacing: .01em; line-height: 1.28; margin-bottom: 24px; max-width: none; }
  .abt__why h2 {
    margin: 0 0 clamp(20px, 2vw, 36px);
    font-weight: 800; letter-spacing: -.03em; color: var(--brown);
    font-size: clamp(32px, 4vw, 76px); line-height: 1.05;
  }
  .abt__why p { margin: 0 0 18px; max-width: 46ch; font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5; }
  .abt__why-b p:last-child { margin-bottom: 0; }
  .abt__why-b em { font-family: var(--hc-serif); font-style: italic; font-weight: 600; }

  /* the outlined band across the foot, cropped by the section */
  .abt__why .abt__marquee {
    position: absolute; left: 0; right: 0; bottom: calc(-1 * clamp(10px, 1.4vw, 28px));
    z-index: 2; margin: 0; overflow: hidden;
    display: flex; white-space: nowrap;
    font-weight: 800; letter-spacing: .03em; line-height: .86;
    font-size: clamp(44px, 7.4vw, 142px);
    color: transparent; -webkit-text-stroke: 1px rgba(37, 37, 37, .34);
  }
  .abt__marquee-track { display: flex; width: max-content; }

  @media (max-width: 900px) {
    .abt__why-inner { min-height: 0; gap: 36px; grid-template-columns: minmax(0, 1fr); }
    .abt__why-a { max-width: none; }
    /* a strict circle wide enough for this copy would be wider than
       the phone; on mobile it becomes an oval instead, matching the
       homepage's own closing arch shape language */
    .abt__why-b {
      position: static; width: 150vw; aspect-ratio: auto;
      margin: 32px 0 calc(-1 * clamp(70px, 9vw, 190px));
      margin-left: calc(-1 * clamp(24px, 5vw, 123px) - 25vw);
      padding: 30vw calc(25vw + 11vw) 22vw;
      box-sizing: border-box;
      border-radius: 50% 50% 0 0 / 75vw 75vw 0 0;
      transform: translateY(calc((1 - var(--in)) * 60vh));
    }
    .abt__why-copy { max-width: none; text-align: left; }
    .abt__why .abt__why-copy p { font-size: clamp(17px, 4.4vw, 22px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .abt__why-b { transform: none; }
  }
</style>

<script>
  import { setupWhyCollective } from "../scripts/whyCollective";
  import { setupMarquees } from "../scripts/marquee";
  setupWhyCollective();
  setupMarquees(".abt__marquee-track");
</script>
