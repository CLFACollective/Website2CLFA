---
import GridField from "./GridField.astro";
---

<section class="win win--flat" data-win>
  <div class="win__frame" style="background:#506E78;color:#FFFAF5">
    <GridField />
    <div class="win__copy" style="color:#FFFAF5">
      <h2 class="win__partnering-head reveal" data-reveal-eager style="font-size:clamp(40px,9.4vw,120px)">
        Here&rsquo;s what<br class="mobile-br" /> partnering with us is
        <span class="bd" style="color:#FFA235;font-weight:800;letter-spacing:0">actually like.</span>
      </h2>
    </div>
  </div>
</section>
