---
import ClfaWordmark from "./ClfaWordmark.astro";
import { footerLinks, linkedinUrl, isCurrent } from "../lib/navigation";

const path = Astro.url.pathname;
---

<footer class="foot" id="contact">
  <div class="foot__inner">
    <div class="foot__top">
      <div class="foot__brand">
        <ClfaWordmark class="foot__logo" />
        <p class="foot__go">
          Is it <span class="foot__go-em">go time?</span>
        </p>
        <a class="btn btn--fill" href="/contact">Meet Your Team</a>
      </div>
      <nav class="foot__nav" aria-label="Footer">
        <p class="eyebrow">Explore</p>
        {footerLinks.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href, path) ? "page" : undefined}>{l.footerLabel}</a>
        ))}
      </nav>
      <div class="foot__contact">
        <p class="eyebrow">Get in touch</p>
        <a href="mailto:hello@clfacollective.com">hello@clfacollective.com</a>
        <a href={linkedinUrl} rel="noreferrer">LinkedIn</a>
      </div>
    </div>
    <div class="foot__row">
      <p>&copy; 2026 CLFA Collective</p>
    </div>
  </div>
</footer>
