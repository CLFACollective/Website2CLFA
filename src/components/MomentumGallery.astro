---
// MomentumGallery — plays like a short movie, not a scroll-scrubbed
// carousel: each slide flies in from a side, holds, then flies on
// toward the camera and off-screen, 2 seconds total per slide — the
// next slide starts its own entrance a bit before that finishes (see
// NEXT_START_PROGRESS in momentumGallery.ts), not strictly one-at-a-time.
// It plays automatically the first time the section scrolls into view
// (never locking scroll). Once it finishes — or if the visitor scrolls
// away first — the section settles on a static "overview" grid of every
// slide's content at once; scrolling away and back into view restarts
// the movie from slide 0, same as a fresh first visit, and a "Replay"
// button on the overview grid does the same on demand. See
// momentumGallery.ts.
//
// Slide order (data-mg-index, top to bottom in the markup below): 0 is
// "They move at the speed of business" — a quote, not a stat. 1-3 are
// the three stats, 4 is the closing Kaylen quote.
import ShineField from "./ShineField.astro";
---

<section class="pin" id="momentum">
  <div class="pin__stage" id="mgStage">
    <ShineField class="shine-momentum" bandEnd={28} mobileBandEnd={19} bg="#FEFCF4" />
    <!-- band-end/mobile-band-end mirror the ShineField props directly
         above — keeps shimmer.ts's twinkle dots confined to the same
         dusty band instead of scattering into the bare cream space
         the 3D gallery sits in below it (see shimmer.ts). -->
    <div class="shimmer" aria-hidden="true" data-band-end="28" data-mobile-band-end="19"></div>

    <div class="hs__head">
      <h2 class="hs__intro-head">
        <span class="bd">Measurable<br /><span class="hot">momentum<span class="hs__dot">.</span></span></span>
      </h2>
    </div>

    <div class="mg__scene" id="mgScene">
      <canvas class="mg__canvas" id="mgCanvas" aria-hidden="true"></canvas>

      <div class="mg__slide mg__slide--quote" data-mg-index="0">
        <blockquote class="mquote">
          <span class="mquote__l1">They move<span class="mquote__badge" aria-hidden="true">
              <svg viewBox="0 0 112 112" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_2838_2564_g)">
                  <path d="M0 56C0 25.0721 25.0721 0 56 0C86.9279 0 112 25.0721 112 56C112 86.9279 86.9279 112 56 112C25.0721 112 0 86.9279 0 56Z" fill="#BE7837"></path>
                  <path d="M70.0776 83.824L63.1196 77.65C64.6223 76.9967 66.6476 75.7227 69.1956 73.828C71.809 71.868 74.161 69.5487 76.2516 66.87C78.3423 64.1913 79.3876 61.382 79.3876 58.442C78.7996 59.0953 77.7216 59.618 76.1536 60.01C74.651 60.402 73.1156 60.598 71.5476 60.598C68.3463 60.598 65.3083 59.3567 62.4336 56.874C59.6243 54.326 58.2196 50.4387 58.2196 45.212C58.2196 39.4627 59.951 34.9547 63.4136 31.688C66.8763 28.356 71.123 26.69 76.1536 26.69C81.315 26.69 85.5943 28.4867 88.9916 32.08C92.4543 35.6733 94.1856 40.9653 94.1856 47.956C94.1856 53.9667 93.0096 59.324 90.6576 64.028C88.371 68.732 85.3983 72.75 81.7396 76.082C78.1463 79.3487 74.259 81.9293 70.0776 83.824ZM25.4876 83.824L18.4316 77.65C19.9343 76.9967 21.9596 75.7227 24.5076 73.828C27.121 71.868 29.473 69.5487 31.5636 66.87C33.6543 64.1913 34.6996 61.382 34.6996 58.442C34.1116 59.0953 33.0336 59.618 31.4656 60.01C29.963 60.402 28.4603 60.598 26.9576 60.598C23.691 60.598 20.6203 59.3567 17.7456 56.874C14.9363 54.326 13.5316 50.4387 13.5316 45.212C13.5316 39.4627 15.263 34.9547 18.7256 31.688C22.1883 28.356 26.435 26.69 31.4656 26.69C36.627 26.69 40.9063 28.4867 44.3036 32.08C47.7663 35.6733 49.4976 40.9653 49.4976 47.956C49.4976 53.9667 48.3543 59.324 46.0676 64.028C43.781 68.732 40.8083 72.75 37.1496 76.082C33.491 79.3487 29.6036 81.9293 25.4876 83.824Z" fill="#FFFAF5"></path>
                </g>
                <defs>
                  <clipPath id="clip0_2838_2564_g">
                    <path d="M0 56C0 25.0721 25.0721 0 56 0C86.9279 0 112 25.0721 112 56C112 86.9279 86.9279 112 56 112C25.0721 112 0 86.9279 0 56Z" fill="white"></path>
                  </clipPath>
                </defs>
              </svg>
            </span></span>
          <span class="mquote__l2">at the speed</span>
          <span class="mquote__l3">of business</span>
        </blockquote>
        <p class="mquote__by">Client, Head of Marketing Center of Excellence</p>
      </div>

      <div class="mg__slide mg__slide--stat" data-mg-index="1">
        <p class="mfig" data-mg-count="100" data-mg-suffix="%">0<span class="unit">%</span></p>
        <p class="mcap">on-time delivery</p>
        <h3>Launches that actually launch. On time.</h3>
      </div>

      <div class="mg__slide mg__slide--stat" data-mg-index="2">
        <p class="mfig" data-mg-count="4" data-mg-prefix="$" data-mg-suffix="M"><span class="mfig__prefix">$</span>0<span class="unit">M</span></p>
        <p class="mcap">Sales pipeline in 4 months</p>
        <h3>Metrics-busting content<br />and paid.</h3>
      </div>

      <div class="mg__slide mg__slide--stat" data-mg-index="3">
        <p class="mfig mfig--wide" data-mg-count="150" data-mg-suffix="+">0<span class="unit">+</span></p>
        <p class="mcap">RSVPs to an Ontologies insider talk</p>
        <h3>Webinars so successful we need crowd control.</h3>
      </div>

      <div class="mg__slide mg__slide--quote mg__slide--wide" data-mg-index="4">
        <blockquote class="mquote mquote--long">
          <span class="mquote__k1">I could easily mistake<span class="mquote__badge" aria-hidden="true">
              <svg viewBox="0 0 112 112" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_2838_2564_k)">
                  <path d="M0 56C0 25.0721 25.0721 0 56 0C86.9279 0 112 25.0721 112 56C112 86.9279 86.9279 112 56 112C25.0721 112 0 86.9279 0 56Z" fill="#BE7837"></path>
                  <path d="M70.0776 83.824L63.1196 77.65C64.6223 76.9967 66.6476 75.7227 69.1956 73.828C71.809 71.868 74.161 69.5487 76.2516 66.87C78.3423 64.1913 79.3876 61.382 79.3876 58.442C78.7996 59.0953 77.7216 59.618 76.1536 60.01C74.651 60.402 73.1156 60.598 71.5476 60.598C68.3463 60.598 65.3083 59.3567 62.4336 56.874C59.6243 54.326 58.2196 50.4387 58.2196 45.212C58.2196 39.4627 59.951 34.9547 63.4136 31.688C66.8763 28.356 71.123 26.69 76.1536 26.69C81.315 26.69 85.5943 28.4867 88.9916 32.08C92.4543 35.6733 94.1856 40.9653 94.1856 47.956C94.1856 53.9667 93.0096 59.324 90.6576 64.028C88.371 68.732 85.3983 72.75 81.7396 76.082C78.1463 79.3487 74.259 81.9293 70.0776 83.824ZM25.4876 83.824L18.4316 77.65C19.9343 76.9967 21.9596 75.7227 24.5076 73.828C27.121 71.868 29.473 69.5487 31.5636 66.87C33.6543 64.1913 34.6996 61.382 34.6996 58.442C34.1116 59.0953 33.0336 59.618 31.4656 60.01C29.963 60.402 28.4603 60.598 26.9576 60.598C23.691 60.598 20.6203 59.3567 17.7456 56.874C14.9363 54.326 13.5316 50.4387 13.5316 45.212C13.5316 39.4627 15.263 34.9547 18.7256 31.688C22.1883 28.356 26.435 26.69 31.4656 26.69C36.627 26.69 40.9063 28.4867 44.3036 32.08C47.7663 35.6733 49.4976 40.9653 49.4976 47.956C49.4976 53.9667 48.3543 59.324 46.0676 64.028C43.781 68.732 40.8083 72.75 37.1496 76.082C33.491 79.3487 29.6036 81.9293 25.4876 83.824Z" fill="#FFFAF5"></path>
                </g>
                <defs>
                  <clipPath id="clip0_2838_2564_k">
                    <path d="M0 56C0 25.0721 25.0721 0 56 0C86.9279 0 112 25.0721 112 56C112 86.9279 86.9279 112 56 112C25.0721 112 0 86.9279 0 56Z" fill="white"></path>
                  </clipPath>
                </defs>
              </svg>
            </span></span>
          <span class="mquote__k1">Michelle for a partner<br class="mobile-br" /> in the company.</span>
          <span class="mquote__k2">She&rsquo;s always sending<br class="mobile-br" /> me ideas,</span>
          <span class="mquote__k1">and she knows<br class="mobile-br" /> the strategy and our<br class="mobile-br" /> business almost as<br class="mobile-br" /> well as I do.</span>
        </blockquote>
        <p class="mquote__by">Kaylen</p>
      </div>

      <!-- static layout of every slide's own content, built once from
           each slide's own DOM (momentumGallery.ts's buildOverviewCards)
           — no content duplicated by hand here. This is the section's
           resting state once the movie has played through or been left;
           hidden only while the movie is actually playing. Scoped to
           #mgScene, not a sibling of it, so it only ever covers the
           scene's own area below the heading — matching the Figma
           design, where the heading sits above this composition, not
           behind it. -->
      <div class="mg__overview" id="mgOverview" hidden>
        <div class="mg__ov-grid" id="mgOvGrid"></div>
      </div>
    </div>

    <button class="mg__ov-toggle btn" id="mgOvToggle" type="button">
      Replay
    </button>
  </div>
</section>

<script>
  import { setupMomentumGallery } from "../scripts/momentumGallery";
  setupMomentumGallery();
</script>
