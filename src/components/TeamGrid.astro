---
// TeamGrid — the two team cards on About. At rest a rounded square,
// as in the Figma comp; on hover or keyboard focus the frame rounds
// into a circle and a mailto pill fades up. Pure CSS state transition
// (:hover/:focus-within) — no script needed. The pill is a real
// mailto link and never display:none, so it stays in the tab order
// and reads normally to a screen reader even before it's visually
// revealed.
const TEAM = [
  { name: "Cathy L. Fink", role: "The CLF in CLFA", email: "cathy@clfacollective.com", photo: "/img/team/cathy.jpg" },
  { name: "Michelle Anderson", role: "The A in CLFA", email: "michelle@clfacollective.com", photo: "/img/team/michelle.jpg" },
];
---

<section class="abt__team">
  <ul class="abt__grid">
    {TEAM.map((m) => (
      <li class="abt__member">
        <div class="abt__frame">
          <img src={m.photo} alt={m.name} loading="lazy" decoding="async" />
        </div>
        <a class="abt__pill" href={`mailto:${m.email}`}>{m.email}</a>
        <p class="abt__name">{m.name}</p>
        <p class="abt__role">{m.role}</p>
        <a class="abt__li" href="https://www.linkedin.com/" rel="noreferrer" aria-label={`${m.name} on LinkedIn`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
            ></path>
          </svg>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .abt__team { background: var(--cream); padding: clamp(56px, 7vw, 120px) clamp(24px, 5vw, 123px) clamp(60px, 8vw, 130px); }
  .abt__grid {
    list-style: none; margin: 0 auto; padding: 0; max-width: 1100px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(28px, 5vw, 96px); justify-items: center;
  }
  .abt__member { position: relative; text-align: center; width: 100%; max-width: 392px; }

  .abt__frame {
    position: relative; overflow: hidden;
    aspect-ratio: 1 / 1.024;
    border-radius: 28px;
    transition: border-radius .55s var(--ease);
  }
  .abt__frame img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .55s var(--ease);
  }
  .abt__member:hover .abt__frame,
  .abt__member:focus-within .abt__frame { border-radius: 50%; }
  .abt__member:hover .abt__frame img,
  .abt__member:focus-within .abt__frame img { transform: scale(1.04); }

  .abt__pill {
    position: absolute; left: 50%; top: calc(50% - 46px);
    transform: translate(-50%, calc(-50% + 14px));
    display: inline-block; white-space: nowrap;
    padding: 11px 22px; border-radius: 100px;
    background: var(--rose); color: var(--charcoal); text-decoration: none;
    font-size: clamp(12px, 1vw, 15px); font-weight: 700;
    box-shadow: 0 10px 28px rgba(37, 37, 37, .22);
    opacity: 0; pointer-events: none;
    transition: opacity .35s ease, transform .45s var(--ease), background .25s ease, color .25s ease;
  }
  .abt__member:hover .abt__pill,
  .abt__pill:focus-visible { opacity: 1; transform: translate(-50%, -50%); pointer-events: auto; }
  .abt__pill:hover { background: var(--charcoal); color: var(--rose); }

  .abt__name { margin: 22px 0 2px; font-size: clamp(21px, 1.7vw, 32px); font-weight: 400; letter-spacing: -.02em; }
  .abt__role {
    margin: 0 0 14px; color: var(--brown);
    font-family: var(--hc-serif); font-style: italic; font-weight: 600; font-size: clamp(15px, 1.1vw, 21px);
  }
  .abt__li { display: inline-block; color: var(--rose); }
  .abt__li svg { width: 22px; height: 22px; display: block; }
  @media (hover: hover) {
    .abt__li:hover { color: var(--brown); }
  }

  @media (max-width: 900px) {
    .abt__pill {
      opacity: 1; transform: none; pointer-events: auto;
      position: static; display: inline-block; margin: 14px auto 0;
      box-shadow: none;
    }
    .abt__member:hover .abt__pill,
    .abt__pill:focus-visible { transform: none; }
    .abt__member:hover .abt__frame { border-radius: 24px; }
    .abt__member:hover .abt__frame img { transform: none; }
    .abt__frame { border-radius: 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .abt__frame, .abt__frame img, .abt__pill { transition: none; }
  }
</style>
