---
import ClfaWordmark from "./ClfaWordmark.astro";
---

<footer class="foot" id="contact" style="background:#232323">
  <div class="foot__inner">
    <div class="foot__top">
      <div class="foot__brand">
        <ClfaWordmark class="foot__logo" />
        <p class="foot__go">
          Is it <span style="color:var(--pink);font-weight:800">go time?</span>
        </p>
        <a class="btn btn--fill" href="#contact">Meet Your Team</a>
      </div>
      <nav class="foot__nav">
        <p class="eyebrow">Explore</p>
        <a href="#motion">What we do</a>
        <a href="#partnering">How we work</a>
        <a href="#who">Who we work with</a>
        <a href="#momentum">Results</a>
      </nav>
      <div class="foot__contact">
        <p class="eyebrow">Get in touch</p>
        <a href="mailto:hello@clfacollective.com">hello@clfacollective.com</a>
        <a href="#">LinkedIn</a>
      </div>
    </div>
    <div class="foot__row">
      <p>&copy; 2026 CLFA Collective</p>
    </div>
  </div>
</footer>
