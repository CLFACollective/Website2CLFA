---
// MarketingForEquity — the light-blue equity card band on What We Do.
// The cards work like the home page's brand-in-motion cards (same
// script, setupCardFan in cardsFan.ts): on desktop the deck deals into a
// fan once in view and a hovered card lifts out; below 1000px the cards
// pin as a deck, each sliding up onto the last. The icons stay upright
// however the card is tilted.
interface Card {
  icon: string;
  label: string;
  body: string[];
}

const CARDS: Card[] = [
  { icon: "/icons/market-planning.svg", label: "Go-to-market planning", body: ["or launches, raises,", "and pivots"] },
  { icon: "/icons/content.svg", label: "Messaging that works", body: ["on investors and customers", "(yes, both)"] },
  { icon: "/icons/infrastructure.svg", label: "Brand infrastructure", body: ["that survives your next funding round"] },
  { icon: "/icons/growth.svg", label: "Growth marketing", body: ["built for lean teams, not bloated ones"] },
  { icon: "/icons/fractional.svg", label: "Fractional CMO support", body: ["by us, not a junior team who just got the brief"] },
];
---

<section class="mfe" id="equity">
  <div class="mfe__top">
    <h2 class="mfe__head">
      <span class="mfe__head-a">Marketing for equity-backed companies</span>
      <span class="mfe__head-b">with</span>
      <strong>less ramp-up, more rollout.</strong>
    </h2>

    <div class="mfe__intro">
      <p class="mfe__ask">Funding round closing? Category shifting under your feet?</p>
      <p class="mfe__lede">
        We build the marketing engine that scales at the same speed as your cap
        table. No six-month ramp-up, no generalist agency learning your industry on
        your dime.
      </p>
    </div>
  </div>

  <div class="mfe__pin" id="mfePin">
    <div class="mfe__stage" id="mfeStage">
      <ul class="mfe__fan" id="mfeFan">
        {CARDS.map((c) => (
          <li class="mfe__card">
            <img class="mfe__icon" src={c.icon} alt="" loading="lazy" decoding="async" />
            <p class="mfe__copy">
              <strong>{c.label}</strong><br />
              <span set:html={c.body.join("<br />")} />
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .mfe {
    --lede: clamp(22px, 1.72vw, 30px);
    position: relative;
    background: rgba(186, 205, 220, 0.5);
    font-family: var(--sans);
    padding: clamp(80px, 8vw, 150px) 0 clamp(48px, 5vw, 96px);
  }

  .mfe__top {
    /* heading and intro split the width 50/50 */
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(32px, 5vw, 96px);
    padding: 0 clamp(24px, 6.4vw, 123px);
  }
  .mfe__head {
    margin: 0;
    font-weight: 300; line-height: .9; letter-spacing: -.01em;
    font-size: clamp(40px, 4.75vw, 91px);
    color: #344338;
  }
  .mfe__head-b { color: var(--charcoal); }
  .mfe__head strong { font-weight: 800; color: var(--brown); }

  /* one block: the question on top, 20% larger than the paragraph
     below it — both well under the heading's size, so it leads */
  .mfe__intro {
    display: grid; gap: clamp(10px, 1vw, 18px);
    padding-top: clamp(6px, 1.2vw, 22px);
  }
  .mfe__ask, .mfe__lede { margin: 0; color: var(--charcoal); line-height: 1.4; }
  .mfe__ask { font-size: calc(var(--lede) * 1.2); font-weight: 700; line-height: 1.25; }
  .mfe__lede { font-size: var(--lede); }

  /* desktop: no pin, nothing scroll-driven — the fan just sits in flow */
  .mfe__pin { position: relative; }
  .mfe__stage { position: relative; }
  .mfe__fan {
    position: relative; margin: 0; padding: 0; list-style: none;
    height: clamp(420px, 38vw, 700px);
    margin-top: clamp(16px, 2vw, 40px);
  }

  .mfe__card {
    position: absolute; left: 50%; top: 50%;
    width: clamp(180px, 16.5vw, 310px);
    aspect-ratio: 328.49 / 347.01;
    box-sizing: border-box;
    border-radius: clamp(18px, 1.9vw, 37px);
    padding: clamp(16px, 1.55vw, 30px);
    display: flex; flex-direction: column; justify-content: flex-end;
    transform-origin: 50% 50%;
    transform: translate(-50%, -50%);
    will-change: transform;

    /* frosted glass; opaque enough that a card beneath doesn't read through */
    background: rgba(240, 244, 245, 0.82);
    backdrop-filter: blur(14px) saturate(1.08);
    -webkit-backdrop-filter: blur(14px) saturate(1.08);
    border: 1px solid rgba(254, 252, 244, 0.6);
    box-shadow: 0 14px 34px rgba(52, 67, 56, .12);
    transition: box-shadow .45s var(--ease);
  }
  .mfe__card[data-active="true"] { box-shadow: 0 24px 56px rgba(52, 67, 56, .24); }

  .mfe__icon {
    position: absolute; display: block;
    top: 9%; right: 9%; width: 38%; height: auto; aspect-ratio: 1;
    transform-origin: center;
  }

  .mfe__copy {
    margin: 0; position: relative;
    font-size: clamp(14px, 1.16vw, 22px); line-height: 1.4; color: #000;
  }
  .mfe__copy strong { font-weight: 700; color: var(--brown); }

  /* Below 1000px: the heading and intro scroll past as normal, then the
     cards pin as a deck (setupCardStack sets the pin's height). */
  @media (max-width: 999px) {
    .mfe { padding: clamp(56px, 9vw, 96px) 0 0; }
    .mfe__top { grid-template-columns: 1fr; gap: 0; padding: 0 24px; }
    .mfe__head { font-size: clamp(38px, 8.6vw, 64px); margin-bottom: .5em; }
    .mfe__intro { gap: 8px; padding-top: 0; }
    .mfe { --lede: 19px; }

    .mfe__stage {
      position: sticky; top: 0; height: 100svh; overflow: hidden;
      display: flex; flex-direction: column;
      /* top padding clears the fixed nav (logo + menu button) */
      padding: 96px 24px 24px; box-sizing: border-box;
    }
    .mfe__fan { flex: 1 1 auto; min-height: 0; height: auto; margin: 0; }
    .mfe__card {
      width: min(420px, 84vw, calc((100svh - 150px) * 328.49 / 347.01));
      border-radius: 28px; padding: 26px;
    }
    .mfe__copy { font-size: clamp(18px, 5vw, 24px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mfe__stage { position: static; height: auto; }
    .mfe__fan { display: grid; gap: 20px; justify-items: center; height: auto; }
    .mfe__card { position: relative; left: auto; top: auto; transform: none !important; }
  }
</style>

<script>
  import { setupCardFan } from "../scripts/cardsFan";
  setupCardFan({
    pin: document.getElementById("mfePin"),
    stage: document.getElementById("mfeStage"),
    fan: document.getElementById("mfeFan"),
    uprightSelector: ".mfe__icon",
    spread: 1.1,
  });
</script>
