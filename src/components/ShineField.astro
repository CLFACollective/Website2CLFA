---
// ShineField — replaces BlingField's drifting dust. Every square in the
// grid is always shown (no per-dot rest/fall lifecycle). Sizes/opacity/
// colour mix are measured directly off the Figma reference dust field
// (node 2964:20817's parent "Bling" group, sampled 2026-09-14): ~1,884
// squares across a ~732×725 tile, sizes skewed heavily toward small,
// opacity 0.5–0.94 on top of a constant 0.6 fill-opacity (~0.3–0.56
// effective), ~96% ink-coloured with a ~4% pink accent. Sizes are
// scaled to 60% of that measured range (SIZE_SCALE below) — full-size
// read as too heavy/prominent once seen on the actual page — and about
// a third of squares get rounded corners instead of sharp ones, for a
// bit of shape variety on top of the size/opacity mix.
//
// A thin vertical band slowly sweeps left to right (see shineField.ts):
// wherever it currently sits, the squares underneath are hidden — a
// moving "hole" in the field, not a reveal of some brighter version
// underneath, and not a per-square opacity fade. Squares behind the
// band come right back once it's moved past.
//
// Squares are generated once at build time (Astro runs server-side) and
// tiled via an SVG <pattern> rather than laid out across the whole
// section — a pattern repeats natively at any container size without
// stretching/distorting the squares the way scaling a fixed viewBox to
// fill a variable-aspect-ratio section would, and it's far cheaper than
// emitting one <rect> per square across a full 1920px-wide section.
interface Props {
  class?: string;
  /** Tile size in px — the pattern repeats at this interval. */
  tile?: number;
  /** Average spacing between squares within the tile, in px. */
  cell?: number;
}
const { class: className, tile = 500, cell = 17 } = Astro.props;
const patternId = `shine-${crypto.randomUUID().slice(0, 8)}`;

const PINK = "#F06496";
const ACCENT_CHANCE = 0.04;
// Scaled to 60% of the originally-measured 0.4–6.5px range — the full
// size read as too prominent/heavy once seen on the page.
const SIZE_SCALE = 0.6;
const MIN_SIZE = 0.4 * SIZE_SCALE;
const MAX_SIZE = 6.5 * SIZE_SCALE;
const MIN_ALPHA = 0.3;
const MAX_ALPHA = 0.56;
// Fraction of squares that get rounded corners instead of sharp ones —
// "some," not all, for a bit of shape variety alongside the size mix.
const ROUNDED_CHANCE = 0.35;
const ROUNDED_RADIUS_FRAC = 0.3; // corner radius as a fraction of the square's own size

const cols = Math.round(tile / cell);
const rows = Math.round(tile / cell);

const squares = Array.from({ length: cols * rows }, (_, i) => {
  const col = i % cols;
  const row = Math.floor(i / cols);

  // Squaring a uniform random biases it toward 0 — the same "mostly
  // small, occasionally large" skew measured in the Figma reference.
  const sizeFrac = Math.random() ** 2;
  const size = MIN_SIZE + sizeFrac * (MAX_SIZE - MIN_SIZE);
  const alpha = MIN_ALPHA + sizeFrac * (MAX_ALPHA - MIN_ALPHA) + (Math.random() - 0.5) * 0.08;

  const jitterX = (Math.random() - 0.5) * cell * 0.5;
  const jitterY = (Math.random() - 0.5) * cell * 0.5;
  const cx = col * cell + cell / 2 + jitterX;
  const cy = row * cell + cell / 2 + jitterY;

  return {
    x: (cx - size / 2).toFixed(2),
    y: (cy - size / 2).toFixed(2),
    s: size.toFixed(2),
    r: Math.random() < ROUNDED_CHANCE ? (size * ROUNDED_RADIUS_FRAC).toFixed(2) : "0",
    o: Math.max(0.15, Math.min(0.65, alpha)).toFixed(2),
    fill: Math.random() < ACCENT_CHANCE ? PINK : "currentColor",
  };
});
---

<div class:list={["shine-wrap", className]} aria-hidden="true">
  <div class="shine-band-y">
    <svg class="shine-field">
      <defs>
        <pattern id={patternId} width={tile} height={tile} patternUnits="userSpaceOnUse">
          {squares.map((sq) => (
            <rect x={sq.x} y={sq.y} width={sq.s} height={sq.s} rx={sq.r} ry={sq.r} fill={sq.fill} opacity={sq.o} />
          ))}
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#${patternId})`} />
    </svg>
  </div>
</div>

<script>
  import { setupShineField } from "../scripts/shineField";
  setupShineField();
</script>

<style>
  .shine-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    /* confined to the upper third of the section, fading out rather
       than cutting off hard at the edge */
    mask-image: linear-gradient(to bottom, #000 0%, #000 20%, transparent 30%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 20%, transparent 30%);
    --band: -20%;
  }
  /* Second band, travels top-to-bottom instead of left-to-right, half
     the first band's thickness, full width (a horizontal gradient band
     is inherently constant across the whole width already — nothing
     extra needed for that). A separate nested element rather than a
     second mask-image layer on .shine-field: two mask-image layers on
     one element composite via mask-composite (default "add", which
     unions rather than intersects — a region only one band is dimming
     would get washed back to full visibility by the other, undimmed,
     layer). Nested masks multiply naturally instead — parent and child
     each reduce visibility independently, so whichever band is over a
     given spot, that dimming holds regardless of what the other band
     is doing elsewhere. */
  .shine-band-y {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(var(--band-y) - 3%),
      rgba(0, 0, 0, 0.35) calc(var(--band-y) - 1.5%),
      rgba(0, 0, 0, 0.35) calc(var(--band-y) + 1.5%),
      #000 calc(var(--band-y) + 3%),
      #000 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 calc(var(--band-y) - 3%),
      rgba(0, 0, 0, 0.35) calc(var(--band-y) - 1.5%),
      rgba(0, 0, 0, 0.35) calc(var(--band-y) + 1.5%),
      #000 calc(var(--band-y) + 3%),
      #000 100%
    );
    --band-y: -20%;
  }
  .shine-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* a moving strip where the squares are dimmed (not fully erased —
       rgba alpha, not "transparent") with a soft feathered edge (a
       gradual ramp either side of the dimmed core, not a hard cut).
       Still mask-image rather than clip-path: clip-path can only ever
       keep one contiguous inset region, it can't cut a hole out of the
       middle of a shape the way this band needs to. Position tracks
       --band exactly, set by shineField.ts. */
    mask-image: linear-gradient(
      to right,
      #000 0%,
      #000 calc(var(--band) - 6%),
      rgba(0, 0, 0, 0.35) calc(var(--band) - 3%),
      rgba(0, 0, 0, 0.35) calc(var(--band) + 3%),
      #000 calc(var(--band) + 6%),
      #000 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0%,
      #000 calc(var(--band) - 6%),
      rgba(0, 0, 0, 0.35) calc(var(--band) - 3%),
      rgba(0, 0, 0, 0.35) calc(var(--band) + 3%),
      #000 calc(var(--band) + 6%),
      #000 100%
    );
  }
</style>
