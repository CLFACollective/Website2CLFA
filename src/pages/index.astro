---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import BrandInMotionCards from "../components/BrandInMotionCards.astro";
import Ribbons from "../components/Ribbons.astro";
import WindowA from "../components/WindowA.astro";
import DayOne from "../components/DayOne.astro";
import KeepUp from "../components/KeepUp.astro";
import MomentumGallery from "../components/MomentumGallery.astro";
import Who from "../components/Who.astro";
import WindowB from "../components/WindowB.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="CLFA Collective — We are the solve for brands in motion">
  <Nav />

  <main id="main" tabindex="-1">
    <Hero />

    <div class="act">
      <BrandInMotionCards />
      <Ribbons />
      <WindowA />
      <DayOne />
      <KeepUp />
      <MomentumGallery />
      <Who />
      <WindowB />
    </div>
  </main>

  <Footer />

  <script>
    import "../scripts/main";
  </script>
</Layout>
