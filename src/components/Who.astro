---
import LogoScroller from "./LogoScroller.astro";
---

<section class="sec sec--slate" id="who">
  <div class="sec__inner">
    <div class="who__top">
      <h2 class="sec__head reveal">Who tags us in.</h2>
      <p class="reveal">
        They&rsquo;re healthcare and tech marketing. Equity-backed.
        Some are pre-launch. Some are post-acquisition.
        <span class="hot">All of them are moving fast.</span>
      </p>
    </div>

    <LogoScroller speed={42} />
    <div class="who__gap"></div>
    <LogoScroller speed={52} reverse />
  </div>
</section>
