---
import PinkCursor from "../components/PinkCursor.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "CLFA Collective — an adaptable healthcare B2B agency network of highly experienced thinkers who connect strategy, creative, and execution.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <PinkCursor />
    <slot />
  </body>
</html>
