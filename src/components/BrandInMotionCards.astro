---
// BrandInMotionCards — up to five cards fanned on one screen, on an arc rather
// than a stack or a line. The deck deals into the fan once it comes into
// view; hovering a card lifts it and parts its neighbours (see
// cardsFan.ts). On narrow screens the arc has nowhere to spread, so the
// deck stacks and shuffles instead as the section pins.
import CardIcon from "./CardIcon.astro";
import type { IconName } from "../lib/cardIcons";
import { italicMarkdown } from "../lib/inlineMarkdown";
import data from "../data/cards.json";

// Cards come from src/data/cards.json (CMS: Home page → Brand in motion
// cards) — up to five, in order. Each picks one of the design's four
// colour treatments; the text's *starred* words are the copper italics.
type Theme = { bg: string; fg: string; hot: string; idle: string; hover: string };
const THEMES: Record<string, Theme> = {
  light: { bg: "#DDE6ED", fg: "#252525", hot: "#BE7A3A", idle: "#A5B7BE", hover: "#BE7A3A" },
  forest: { bg: "#344338", fg: "#FEFCF4", hot: "#FF981E", idle: "#858D83", hover: "#FF981E" },
  azure: { bg: "#506E78", fg: "#FEFCF4", hot: "#FF981E", idle: "#9EBBC4", hover: "#FF981E" },
  charcoal: { bg: "#252525", fg: "#FEFCF4", hot: "#FF981E", idle: "#7C7B78", hover: "#FF981E" },
};

const CARDS = (data.cards as { text: string; icon: IconName; color: string }[])
  .slice(0, 5)
  .map((c) => ({ ...c, theme: THEMES[c.color] ?? THEMES.light }));
---

<section class="bmc" id="motion">
  <div class="bmc__pin" id="bmcPin">
    <div class="bmc__stage" id="bmcStage">
      <div class="bmc__top">
        <h2 class="bmc__q">So&hellip; what&rsquo;s a <b>brand in motion?</b></h2>
      </div>

      <div class="bmc__fan" id="bmcFan">
        {CARDS.map((c, i) => (
          <article
            class="bmc__card"
            style={`background:${c.theme.bg};color:${c.theme.fg};--hot:${c.theme.hot};--idle:${c.theme.idle};--hover:${c.theme.hover};--i:${i}`}
          >
            <p class="bmc__copy" set:html={italicMarkdown(c.text)} />
            <span class="bmc__icon"><CardIcon name={c.icon} /></span>
          </article>
        ))}
      </div>

      <div class="bmc__aside">
        <h3 class="bmc__payoff">Sound familiar?</h3>
        <a class="bmc__cta" href="#contact">Let&rsquo;s Talk</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupBrandInMotionCards } from "../scripts/cardsFan";
  setupBrandInMotionCards();
</script>

<style>
  .bmc { position: relative; background: #FEFCF4; color: #252525; }
  /* desktop doesn't pin (no scroll-driven motion); below 1000px the
     script sets the pin's height for the deck */
  .bmc__pin { position: relative; }
  .bmc__stage {
    position: sticky; top: 0; height: 100svh; overflow: hidden;
    display: flex; flex-direction: column; align-items: stretch;
    padding: clamp(34px, 6vh, 76px) clamp(20px, 3vw, 56px) clamp(20px, 4vh, 48px);
  }

  .bmc__q {
    margin: 0; flex: 0 1 auto;
    font-weight: 400; letter-spacing: -.038em; line-height: .997; text-align: left;
    font-size: clamp(30px, 4.4vw, 80px);
    color: #252525;
    opacity: 0; transform: translateY(18px);
  }
  .bmc__q b {
    display: block; font-family: var(--hc-serif, "Lora", Georgia, serif); font-style: italic;
    font-weight: 600; color: #BE7A3A; font-size: clamp(34px, 5vw, 90px);
  }

  .bmc__top {
    flex: 0 0 auto;
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(24px, 4vw, 90px);
    padding: 60px 0 0;
    margin: 0 0 clamp(14px, 2.4vh, 34px);
  }
  .bmc__aside {
    flex: 0 0 auto;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: clamp(12px, 1.6vh, 20px);
    margin: 40px 0 0;
    opacity: 0; transform: translateY(14px);
  }

  .bmc__fan {
    position: relative; flex: 1 1 auto; width: 100%; min-height: 0;
  }
  .bmc__card {
    position: absolute; left: 50%; top: 50%;
    width: clamp(168px, 17.5vw, 300px);
    aspect-ratio: 441 / 540;
    border-radius: clamp(12px, 1.35vw, 26px);
    padding: clamp(15px, 1.6vw, 28px);
    display: flex; flex-direction: column;
    transform-origin: 50% 50%;
    transform: translate(-50%, -50%);
    will-change: transform;
    box-shadow: 0 16px 38px rgba(37, 37, 37, .28);
    transition: box-shadow .45s var(--ease);
  }
  .bmc__card[data-active="true"] { box-shadow: 0 24px 56px rgba(37, 37, 37, .38); }

  .bmc__copy {
    margin: 0; font-weight: 300; letter-spacing: -.02em; line-height: 1.14;
    font-size: clamp(16px, 2.1vw, 36px);
  }
  /* :global — the em comes from the CMS text (set:html), which Astro
     doesn't stamp with this component's scoping attribute */
  .bmc__copy :global(em) {
    font-family: var(--hc-serif, "Lora", Georgia, serif);
    font-style: italic; font-weight: 600; color: var(--hot);
  }

  .bmc__icon {
    position: absolute; right: clamp(13px, 1.5vw, 28px); bottom: clamp(13px, 1.5vw, 28px);
    width: clamp(48px, 4.8vw, 88px); line-height: 0;
    color: var(--idle);
    transition: color .45s var(--ease);
  }
  .bmc__card[data-active="true"] .bmc__icon { color: var(--hover); }
  /* full solid colour on hover, not just a stroke-colour swap — each
     path's fill/stroke-opacity otherwise stays wherever cardsFan.ts's
     draw-in animation left it (an inline style GSAP sets per path and
     never clears), which needs !important to override here. */
  .bmc__card[data-active="true"] .bmc__icon :global(path) {
    fill-opacity: 1 !important;
    stroke-opacity: 1 !important;
  }
  /* the pivot icon idles at half opacity (see CardIcon.astro) rather
     than the idle animation every other icon gets — goes fully opaque
     in focus, same "active" signal as the colour swap above, on both
     desktop (the hovered card) and mobile (slid into
     its resting spot in the stack). */
  .bmc__card[data-active="true"] .bmc__icon :global(.ci--pivot) { opacity: 1; }
  @media (hover: hover) {
    .bmc__card:hover .bmc__icon { color: var(--hover); }
    .bmc__card:hover .bmc__icon :global(path) {
      fill-opacity: 1 !important;
      stroke-opacity: 1 !important;
    }
    .bmc__card:hover .bmc__icon :global(.ci--pivot) { opacity: 1; }
  }

  .bmc__payoff {
    margin: 0; font-weight: 600; color: #BE7A3A;
    letter-spacing: -.03em; line-height: 1.02;
    font-size: clamp(24px, 2.7vw, 48px);
  }
  .bmc__cta {
    display: inline-block; font: inherit; cursor: pointer;
    font-size: clamp(14px, 1.05vw, 18px); font-weight: 500; letter-spacing: .005em;
    color: #252525; background: none; text-decoration: none;
    border: 1.5px solid #252525; border-radius: 999px;
    padding: clamp(12px, 1.05vw, 17px) clamp(26px, 2.6vw, 44px);
    transition: background .3s var(--ease), color .3s var(--ease);
  }
  @media (hover: hover) {
    .bmc__cta:hover { background: #252525; color: #FEFCF4; }
  }

  @media (max-width: 1000px) {
    .bmc__top { padding-left: 0; padding-right: 0; }
    .bmc__icon { right: clamp(16px, 6.4vw, 26px); bottom: clamp(16px, 6.4vw, 26px); }
  }

  /* Below 1000px: a pinned deck (setupCardStack in cardsFan.ts). The
     stage pins full-height with the heading kept in view under the nav;
     the cards stack in the middle, each sliding up onto the last, sized
     to fit what's left of the screen. The pin's height is set by the
     script (scroll per card). */
  @media (max-width: 999px) {
    .bmc__stage {
      position: sticky; top: 0; height: 100svh; overflow: hidden;
      /* top padding clears the fixed nav (logo + menu button) */
      padding: 96px clamp(20px, 6vw, 48px) 24px;
    }
    .bmc__top { padding-top: 0; margin-bottom: 12px; }
    .bmc__q {
      font-size: clamp(28px, 6vw, 44px); font-weight: 400; line-height: 1.15; letter-spacing: -.02em;
    }
    .bmc__q b {
      display: block; margin-top: 4px;
      font-family: var(--hc-serif, "Lora", Georgia, serif);
      font-style: italic; font-weight: 600; color: var(--flare);
      font-size: clamp(33px, 7vw, 52px); letter-spacing: -.01em;
    }

    .bmc__fan { flex: 1 1 auto; min-height: 0; position: relative; }
    .bmc__card {
      left: 50%; top: 50%;
      /* as wide as fits, and no taller than the space between the
         heading and "Sound familiar?" (card is 441:540) */
      width: min(420px, 80vw, calc((100svh - 330px) * 441 / 540));
      padding: clamp(20px, 6vw, 32px);
      justify-content: center; /* copy centred top-to-bottom */
    }
    .bmc__copy { font-size: clamp(26px, 7.4vw, 40px); line-height: 1.15; padding-bottom: 12%; }
    .bmc__icon { width: clamp(52px, 15vw, 86px); }

    .bmc__aside { margin-top: 12px; gap: 10px; }
    .bmc__payoff { font-size: clamp(22px, 5vw, 32px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bmc__pin { height: auto; }
    .bmc__stage { position: static; height: auto; padding: 12vh clamp(22px, 6vw, 48px); }
    .bmc__aside { opacity: 1; transform: none; }
    .bmc__fan { display: grid; gap: 20px; justify-items: center; }
    .bmc__card { position: static !important; transform: none !important; }
    .bmc__q { opacity: 1; transform: none; }
  }
</style>
