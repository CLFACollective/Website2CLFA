---
// QAAccordion — the three grouped Q&A lists on FAQs (Figma "Asked and
// answered"). Unlike ServicesAccordion, any number of rows can be open
// at once (independent per-row toggling, no "close others" logic) —
// they're reference material, not a guided sequence, and the page
// lands with them all closed.
//
// Groups and questions come from src/data/faqs.json — edited in the
// CMS (/admin), where groups and questions can be added, removed, and
// reordered. An answer's paragraphs are separated by a blank line.
import data from "../data/faqs.json";

interface QA {
  q: string;
  answer: string[];
  lead?: string;
  tail?: string;
}
interface Group {
  title: string;
  items: QA[];
}

const GROUPS: Group[] = data.groups.map((g) => ({
  title: g.title,
  items: (g.items ?? []).map((it) => ({
    q: it.question,
    answer: (it.answer ?? "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean),
    lead: it.lead || undefined,
    tail: it.tail || undefined,
  })),
}));
---

<section class="qa" id="faq-list">
  <div class="qa__inner">
    {GROUPS.map((g) => (
      <section class="qa__group">
        <h2>{g.title}</h2>
        <ul>
          {g.items.map((item) => (
            <li class="qa__row">
              <h3>
                <button type="button" class="qa__q" aria-expanded="false">
                  <span>{item.q}</span>
                  <span class="qa__ctrl" aria-hidden="true">
                    <i /><i class="qa__ctrl-v" />
                  </span>
                </button>
              </h3>
              <div class="qa__panel">
                <div class="qa__panel-in">
                  <div class="qa__answer">
                    {item.answer.map((para, n) => (
                      <p>
                        {n === 0 && item.lead && <strong class="qa__lead">{item.lead} </strong>}
                        {para}
                      </p>
                    ))}
                    {item.tail && <p class="qa__lead">{item.tail}</p>}
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style>
  .qa { background: var(--cream); color: var(--charcoal); font-family: var(--sans); }
  .qa__inner {
    max-width: 1560px; margin: 0 auto;
    padding: clamp(52px, 6vw, 104px) clamp(24px, 5vw, 123px) clamp(72px, 9vw, 150px);
  }
  .qa__group { margin: 0 0 clamp(44px, 5vw, 88px); }
  .qa__group > h2 {
    margin: 0 0 clamp(16px, 1.8vw, 30px);
    font-size: clamp(24px, 2.1vw, 38px); font-weight: 800; letter-spacing: -.02em;
  }
  .qa__group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(12px, 1.1vw, 20px); }

  .qa__row {
    border: 1px solid rgba(37, 37, 37, .16); border-radius: 14px;
    padding: clamp(18px, 1.6vw, 26px) clamp(20px, 1.8vw, 30px);
    transition: border-color .3s ease, background .3s ease, color .3s ease;
  }
  .qa__row[data-open] { border-color: rgba(190, 120, 55, .42); }
  @media (hover: hover) {
    .qa__row:not([data-open]):hover,
    .qa__row:not([data-open]):focus-within { background: var(--charcoal); border-color: var(--charcoal); color: var(--cream); }
    .qa__row:not([data-open]):hover .qa__q,
    .qa__row:not([data-open]):focus-within .qa__q { color: var(--cream); }
  }

  .qa__row h3 { margin: 0; font-size: inherit; font-weight: inherit; }
  .qa__q {
    appearance: none; background: none; transition: color .3s ease; border: 0; width: 100%; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: clamp(16px, 2vw, 40px);
    padding: 0; font: inherit; text-align: left;
    color: var(--brown); font-weight: 700; letter-spacing: -.02em;
    font-size: clamp(18px, 1.55vw, 28px); line-height: 1.22;
  }
  .qa__q:focus-visible { outline: 2px solid var(--brown); outline-offset: 6px; border-radius: 4px; }

  .qa__ctrl {
    position: relative; flex: 0 0 auto;
    width: clamp(30px, 2vw, 36px); height: clamp(30px, 2vw, 36px);
    border: 1px solid currentColor; border-radius: 50%;
    transition: background .3s ease, color .3s ease, border-color .3s ease;
  }
  .qa__ctrl i {
    position: absolute; left: 50%; top: 50%; width: 44%; height: 2px;
    margin: -1px 0 0 -22%; background: currentColor; border-radius: 2px;
  }
  .qa__ctrl-v { transform: rotate(90deg); transition: transform .4s var(--ease), opacity .3s ease; }
  .qa__row[data-open] .qa__ctrl { background: var(--charcoal); border-color: var(--charcoal); color: var(--cream); }
  .qa__row[data-open] .qa__ctrl-v { transform: rotate(0deg); opacity: 0; }

  .qa__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .5s var(--ease); }
  .qa__row[data-open] .qa__panel { grid-template-rows: 1fr; }
  .qa__panel-in {
    overflow: hidden; min-height: 0;
    visibility: hidden; transition: visibility 0s linear .5s;
  }
  .qa__row[data-open] .qa__panel-in { visibility: visible; transition-delay: 0s; }

  .qa__answer {
    border-top: 1px solid rgba(37, 37, 37, .14);
    margin-top: clamp(14px, 1.2vw, 20px); padding-top: clamp(14px, 1.2vw, 22px);
  }
  .qa__answer p { margin: 0 0 14px; font-size: clamp(15px, 1.05vw, 19px); line-height: 1.5; }
  .qa__answer p:last-child { margin-bottom: 0; }
  .qa__lead { font-weight: 700; }

  @media (prefers-reduced-motion: reduce) {
    .qa__panel, .qa__ctrl-v { transition: none; }
  }
</style>

<script>
  import { setupQAAccordion } from "../scripts/qaAccordion";
  setupQAAccordion();
</script>
