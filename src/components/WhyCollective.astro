---
// WhyCollective — the "Why a collective?" / "The result" swap closing
// About. A rose arch rises from the foot of a pinned frame as the
// section's own scroll track plays out, covering the "Why a
// collective?" heading and handing off to "The result" underneath it
// — not the two-block side-by-side layout an earlier pass here used.
// Matches the live reference build (match-reach-24295361.figma.site)
// and the original Figma Make source's own mechanic; see
// src/scripts/whyCollective.ts for the scroll math (--in drives the
// arch's rise, --res the cream copy's reveal once the arch has
// climbed far enough to cover the heading behind it). The "READY TO
// MOVE" marquee at the foot reuses marquee.ts, same doubled-track
// technique as LogoScroller.astro. Both blocks' copy comes from
// src/data/about.json (edited in the CMS).
import about from "../data/about.json";
---

<div class="abt__why" data-page-why>
  <div class="abt__why-pin" data-why-pin>
    <div class="abt__why-inner">
      <h2 class="abt__why-h">{about.why.heading}</h2>
      <p class="abt__why-p">{about.why.body}</p>
    </div>

    <div class="abt__arch" data-cursor="invert">
      <div class="abt__result">
        <h2>{about.result.heading}</h2>
        <p>{about.result.body}</p>
      </div>
    </div>

    <p class="abt__marquee" aria-hidden="true">
      <span class="abt__marquee-track" data-seconds="22">
        {[0, 1].map((set) => (
          <span class="abt__marquee-set" aria-hidden={set === 1}>
            READY TO MOVE&nbsp;&middot;&nbsp;READY TO MOVE&nbsp;&middot;&nbsp;READY TO MOVE&nbsp;&middot;&nbsp;
          </span>
        ))}
      </span>
    </p>
  </div>
</div>

<style>
  .abt__why {
    --in: 0;
    --res: 0;
    /* a 2:1 box at full bleed, capped so it always fits inside the
       pinned frame on a short window */
    --archH: min(50vw, 88svh);
    --archRest: 82%; /* resting offset: clears the copy, leaves a sliver */
    --track: 300svh; /* 200svh of run: a 60svh hold, then the rise */
    /* how far "Why a collective?" sits above the arch box's own
       centre — the arch is opaque and covers it before "The result"
       appears, so the two never share the screen */
    --lift: 6vw;
    position: relative;
    height: auto;
    padding-top: clamp(28px, 4vw, 72px);
    background: var(--cream);
  }
  /* Default (portrait / phone): a short pin. The arch-height frame
     sticks, vertically centred, while --run of cream below it scrolls
     past — long enough to read the copy before the arch climbs over it
     (feedback: on phones it used to be covered while it was still
     coming into view). The landscape-ish media query further down
     swaps this for a full-height pinned frame instead. */
  .abt__why {
    --run: 100svh;
    /* height, not padding: a sticky child only travels within its
       parent's content box */
    height: calc(var(--archH) + var(--run));
  }
  .abt__why-pin {
    position: sticky; top: calc((100svh - var(--archH)) / 2);
    height: var(--archH);
    overflow: hidden; background: var(--cream);
  }
  .abt__why-inner {
    position: absolute; left: 0; right: 0; bottom: var(--lift); z-index: 1;
    height: var(--archH); box-sizing: border-box;
    padding: 0 clamp(24px, 5vw, 123px);
    display: grid; align-content: center; justify-items: center;
    text-align: center;
  }
  .abt__why-h {
    margin: 0 0 clamp(20px, 2.4vw, 48px);
    font-weight: 800; letter-spacing: -.03em; line-height: 1.04;
    font-size: clamp(34px, 4.45vw, 96px);
    color: var(--brown);
  }
  .abt__why-p {
    margin: 0; max-width: clamp(320px, 44vw, 850px);
    font-size: clamp(18px, 1.52vw, 32px); line-height: 1.56; letter-spacing: -.01em;
  }

  /* the arch: full-bleed, pinned to the frame's foot, opaque, and
     above the copy it's going to cover */
  .abt__arch {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    height: var(--archH);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    background: var(--rose);
    display: flex; align-items: center; justify-content: center;
    transform-origin: 50% 100%;
    transform: translateY(calc((1 - var(--in)) * var(--archRest)));
    /* a short transition on top of the scroll value acts as a damper
       — takes the step out of a wheel notch without adding noticeable
       lag */
    transition: transform .4s cubic-bezier(.22, .61, .36, 1);
    will-change: transform;
  }
  .abt__result {
    color: var(--cream); text-align: center;
    padding: 0 clamp(28px, 8vw, 150px);
    opacity: var(--res);
    transform: translateY(calc((1 - var(--res)) * 22px));
    transition: opacity .4s linear, transform .5s cubic-bezier(.22, .61, .36, 1);
  }
  .abt__result h2 {
    margin: 0 0 clamp(20px, 2.4vw, 48px);
    font-weight: 800; letter-spacing: -.03em; line-height: 1.04;
    font-size: clamp(34px, 4.45vw, 96px);
    color: var(--cream);
  }
  .abt__result p {
    margin: 0 auto; max-width: clamp(300px, 38vw, 740px);
    font-size: clamp(19px, 1.93vw, 40px); line-height: 1.5; letter-spacing: -.01em;
  }

  /* PIN — only on a landscape-ish frame. The arch is half as tall as
     the viewport is wide, so on a tall window (portrait tablet,
     phone) holding a full-height frame left most of the screen as
     empty cream with the copy stranded at the bottom. */
  @media (min-width: 641px) and (min-aspect-ratio: 7/5) {
    .abt__why { height: var(--track); padding-top: 0; --lift: 14vw; }
    .abt__why-pin { position: sticky; top: 0; height: 100svh; }
  }
  @media (min-width: 641px) and (max-width: 1100px) and (min-aspect-ratio: 7/5) {
    .abt__why { --lift: 12vw; }
  }
  /* below a laptop the arch stops being much taller than the copy it
     has to clear at rest, so the resting sliver is trimmed */
  @media (max-width: 1100px) {
    .abt__why { --archRest: 90%; }
  }

  /* the outlined band across the foot — above the arch, sitting low
     enough that the pin frame's overflow shaves the baseline */
  .abt__why .abt__marquee {
    position: absolute; left: 0; right: 0; bottom: calc(-1 * clamp(3px, 0.62vw, 12px));
    z-index: 3; margin: 0; overflow: hidden;
    display: flex; white-space: nowrap;
    font-weight: 800; letter-spacing: .03em; line-height: .86;
    font-size: clamp(44px, 7.4vw, 142px);
    color: transparent; -webkit-text-stroke: 1px rgba(37, 37, 37, .34);
  }
  .abt__marquee-track { display: flex; width: max-content; }

  /* The homepage widens its arch past the screen edges below 640 so
     the curve stays a true circular arc instead of stretching into a
     tall hump — same override here. */
  @media (max-width: 640px) {
    /* no lift on a phone: the section is only arch-height, so there
       is no dead cream to reclaim */
    .abt__why { --archH: min(76vw, 80svh); --archRest: 100%; --lift: 0px; }
    .abt__arch { left: -26%; right: -26%; }
    .abt__result { padding: 0 clamp(30px, 9vw, 60px); }
    /* the dome can't physically cover a heading nearly as wide as the
       screen on a phone — the corners poked out above the arc. The
       copy hands over on a fade instead, tied to the same scroll
       value so it stays behind the rising edge. */
    .abt__why-inner { opacity: calc(1 - var(--in) * 1.7); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* no pin and no rise, so the arch can't be allowed to cover the
       copy it would normally replace — the whole section unrolls in
       flow and both blocks read, one after the other. */
    .abt__why { height: auto; }
    .abt__why-pin { position: static; height: auto; padding: clamp(48px, 6vw, 120px) 0 0; }
    .abt__why-inner {
      position: static; height: auto; opacity: 1;
      padding: 0 clamp(24px, 5vw, 123px);
    }
    .abt__arch {
      position: static; transform: none; transition: none;
      margin: clamp(40px, 5vw, 90px) 0 0; height: var(--archH);
    }
    .abt__result { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  import { setupWhyCollective } from "../scripts/whyCollective";
  import { setupMarquees } from "../scripts/marquee";
  setupWhyCollective();
  setupMarquees(".abt__marquee-track");
</script>
